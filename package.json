{
  "name": "frontend-lab-1",
  "version": "1.0.0",
  "description": "Лабораторна робота №1 — статичний веб-проєкт з HTML, CSS, TypeScript, ESLint та Prettier",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "lint": "eslint eslint.config.js --max-warnings 0",
    "format": "prettier --write \"**/*.{html,css,js,ts,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{html,css,js,ts,json,md}\" --ignore-path .prettierignore",
    "check": "npm run format:check && npm run lint",
    "build": "npm run build:ts && npm run format && npm run lint"
  },
  "keywords": [
    "html",
    "css",
    "typescript",
    "lab"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  }
}
