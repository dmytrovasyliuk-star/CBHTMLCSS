# EditorConfig — https://editorconfig.org
# Забезпечує однакові налаштування для всіх редакторів/IDE

root = true

# ── Усі файли ────────────────────────────────────────────────────────────────
[*]
charset               = utf-8
end_of_line           = lf
indent_style          = space
indent_size           = 2
trim_trailing_whitespace = true
insert_final_newline  = true

# ── HTML ─────────────────────────────────────────────────────────────────────
[*.html]
indent_size = 2
max_line_length = 120

# ── CSS ──────────────────────────────────────────────────────────────────────
[*.css]
indent_size = 2

# ── JavaScript / TypeScript ───────────────────────────────────────────────────
[*.{js,ts,jsx,tsx}]
indent_size = 2
max_line_length = 100

# ── JSON ─────────────────────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.sh]
end_of_line = lf
